{
  "version": 6,
  "configurePresets": [
    {
      "name": "projects",
      "displayName": "Default project build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/projects",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "projects",
      "configurePreset": "projects"
    }
  ],
  "testPresets": [
    {
      "name": "projects",
      "configurePreset": "projects",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
