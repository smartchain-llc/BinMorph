PROJECT_NAME           = "BinMorph"
OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
INPUT                  = README.md CONTRIBUTING.md docs docker/README.md include src
FILE_PATTERNS          = *.md *.h *.hh *.hpp *.hxx *.ipp *.tpp *.c *.cc *.cpp *.cxx *.ixx *.cppm
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */third_party/* */external/* */vendor/* */generated/* */codex-skills/*
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
GENERATE_TREEVIEW      = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DOT_IMAGE_FORMAT       = svg
ALIASES                = "thread_safety=@par Thread safety:" \
                         "ownership=@par Ownership:" \
                         "complexity=@par Complexity:"
QUIET                  = YES
